# Database
POSTGRES_DB=dbname
POSTGRES_USER=user
POSTGRES_PASSWORD='password'
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# JWT
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Encryption (AES-256-GCM - must be exactly 32 hex bytes = 64 chars)
ENCRYPTION_KEY=

# 2FA
TOTP_ISSUER=EMR_System

# App
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,https://erm.hasafsec.com
DOMAIN=erm-api.hasafsec.com